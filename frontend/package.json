{
  "name": "terrimaint",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "lint": "ng lint",
    "test": "ng test --no-watch",
    "test:watch": "ng test",
    "test:responsive": "tsc --project tsconfig.e2e.json && playwright test",
    "test:responsive:report": "playwright show-report"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "jsqr": "1.4.0",
    "leaflet": "1.9.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/leaflet": "1.9.21",
    "@types/node": "24.19.2",
    "angular-eslint": "22.5.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.61.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": false,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": false,
    "msgpackr-extract@3.0.4": false
  }
}
